rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true; // Consider: if request.auth != null
    }
    
    match /{document=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null 
                             && request.resource.data.size() < 2 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
    
    // Allow read access to 'website' subcollections via collectionGroup
    match /{path=**}/website/{websiteDocId} {
      allow read: if true; // Consider: if request.auth != null
    }
  }
}
