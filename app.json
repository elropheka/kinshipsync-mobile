{
  "expo": {
    "name": "kinshipSync",
    "slug": "kinshipSync",
    "version": "1.1.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "kinshipsync",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EFE8"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "bundleIdentifier": "com.kinshipsyncapp",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDesignRequiresCompatibility": true,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library so you can upload a profile picture for your account and also profiles for family tree.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos and videos for messaging and profile pictures.",
        "NSLocationWhenInUseUsageDescription": "This app may use your location to enhance family tree features and provide location-based services. Location access is optional and can be disabled in your device settings."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5EFE8"
      },
      "package": "com.kinship.kinshipsync",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.433750501084-425hb71ogrc7p04p7cujs0t2qct3igkj"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "appRoot": "./app"
      },
      "eas": {
        "projectId": "ad4bb59d-fd0d-4396-af25-8c32f9c8bb42"
      },
      "messagingApiUrl": "https://kinshipsync-messaging.vercel.app",
      "messagingApiToken": "7149a08e90df44321bd68897da3d811e"
    },
    "runtimeVersion": "1.0.6",
    "updates": {
      "url": "https://u.expo.dev/ad4bb59d-fd0d-4396-af25-8c32f9c8bb42",
      "enabled": true,
      "enableBsdiffPatchSupport": true
    }
  }
}
