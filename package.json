{
  "name": "kinshipsync",
  "main": "index.js",
  "version": "1.0.15",
  "scripts": {
    "build": "pnpm install --frozen-lockfile",
    "start": "npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "test": "jest --watchAll",
    "generate:assets": ".venv-assets/bin/python scripts/generateBrandAssets.py",
    "lint": "npx expo lint",
    "lint:ci": "npx expo lint -- --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "security:scan": "bash scripts/hooks/trivy-scan.sh",
    "precommit:install": "pre-commit install",
    "precommit:run": "pre-commit run --all-files",
    "audit:clean": "tsx scripts/lint/runCleanAudit.ts",
    "audit:clean:strict": "tsx scripts/lint/runCleanAudit.ts --strict",
    "validate": "pnpm run lint:ci && pnpm run typecheck && pnpm run audit:clean"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@firebase/app": "^0.13.2",
    "@firebase/auth": "^1.10.8",
    "@firebase/firestore": "^4.8.0",
    "@perttu/react-native-phone-number-input": "^2.1.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.0.14",
    "@reduxjs/toolkit": "^2.8.1",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "expo": "~55.0.26",
    "expo-apple-authentication": "~55.0.13",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-device": "^55.0.17",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "^55.0.22",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "^55.0.20",
    "expo-linking": "~55.0.15",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "^55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.16",
    "firebase": "^11.7.1",
    "onesignal-expo-plugin": "^2.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-onesignal": "^5.2.16",
    "react-native-pell-rich-editor": "^1.9.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.3.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^15.0.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native-stack": "^7.3.10",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.16",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.18",
    "react-test-renderer": "19.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@types/react": "~19.2.10"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@firebase/app",
          "@firebase/auth",
          "@firebase/firestore",
          "firebase",
          "react-native-vector-icons",
          "@perttu/react-native-phone-number-input",
          "react-native-pell-rich-editor"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
