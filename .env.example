# Messaging API Configuration
# Copy this file to .env and fill in your values
# The .env file is loaded by babel-plugin-inline-dotenv at build time

# Messaging API URL (default: https://kinshipsync-messaging.vercel.app)
MESSAGING_API_URL=https://kinshipsync-messaging.vercel.app

# Messaging API Token (required for authentication)
# Get this from your messaging service configuration
# For production builds, use EAS Secrets instead (see MESSAGING_SETUP.md)
MESSAGING_API_TOKEN=your_api_token_here
