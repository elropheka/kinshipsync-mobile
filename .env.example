# Messaging API Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Messaging API URL (optional, defaults to https://kinshipsync-messaging.vercel.app)
MESSAGING_API_URL=https://kinshipsync-messaging.vercel.app

# Messaging API Token (required for sending emails, SMS, and push notifications)
# Get this token from your messaging service administrator
MESSAGING_API_TOKEN=your_api_token_here
