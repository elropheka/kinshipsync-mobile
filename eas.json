{
  "cli": {
    "version": ">= 16.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "npm": "install --legacy-peer-deps"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "npm": "install --legacy-peer-deps"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "npm": "install --legacy-peer-deps"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
