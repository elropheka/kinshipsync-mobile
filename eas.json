{
  "cli": {
    "version": ">= 16.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "20.19.4",
      "env": {
        "MESSAGING_API_URL": "https://kinshipsync-messaging.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "20.19.4",
      "env": {
        "MESSAGING_API_URL": "https://kinshipsync-messaging.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "20.19.4",
      "env": {
        "MESSAGING_API_URL": "https://kinshipsync-messaging.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
